s like celsius or $ or some other currency etc., between the ground truth and the model submission, but as long as the numbers are approximately equal, the model submission should still be considered correct.\n- The model submission may not mention an exact date or time concerning the information that is discussed in the ground truth response, but as long as the model submission contains the same information as the ground truth, the model submission should still be considered correct.\n- Information may be organized differently in the model submission, but the core facts and insights should align with the ground truth to be considered correct. ${wn}`}var ta=function(Qe){return Qe.None="none",Qe.AddBasicAnnotation="addBasicAnnotation",Qe.AddAnnotationWithMetadata="addDetailedAnnotation",Qe.AddAnnotationAndHydrateChatContextWithMetadata="addAnnotationAndHydrateChatContextWithMetadata",Qe}(ta||{}),ro=function(Qe){return Qe.Error="error",Qe.Info="info",Qe.Warning="warning",Qe}(ro||{}),Oo=function(Qe){return Qe.ZeroPrompt="zero-prompt",Qe.PromptMenu="prompt-menu",Qe}(Oo||{}),xt=function(Qe){return Qe.CreatePage="create-page",Qe.DataQuestion="data-question",Qe.General="general",Qe.Search="search",Qe.Summary="summary",Qe.VerifiedAnswer="verified-answer",Qe}(xt||{});const Zt={state:"loading"},Rt=!1,nn=1,ji=500,Vt=1e4,Ni={hasValidatedArtifact:!1,isValidatingArtifact:!1,validationError:void 0,requiresArtifactValidation:!1};var Cn=function(Qe){return Qe[Qe.Sidecar=0]="Sidecar",Qe[Qe.Immersive=1]="Immersive",Qe[Qe.Inline=2]="Inline",Qe}(Cn||{})},451962:(le,F,e)=>{"use strict";e.d(F,{A_:()=>Ir,Zt:()=>ho,EW:()=>xn,OR:()=>ro,GA:()=>Mi,pX:()=>_n,it:()=>lr,TA:()=>kt,Sd:()=>tn,d4:()=>gl,JS:()=>ec,EI:()=>Ha,b8:()=>ji,yK:()=>q,En:()=>_r,p0:()=>qs,pK:()=>ds,Dd:()=>wi,kM:()=>$e,JI:()=>dt,D5:()=>Fe,$A:()=>wr,C1:()=>Hn,v3:()=>fn,xT:()=>Zo,vb:()=>Mn,B4:()=>Ol,pw:()=>Fl,_G:()=>Yl,S7:()=>Tr,Sf:()=>Ko,ef:()=>k,wg:()=>L,O9:()=>Qe,ku:()=>ss,sk:()=>tc,CX:()=>Ai,Zc:()=>xs,jA:()=>nl,i6:()=>Sr,A5:()