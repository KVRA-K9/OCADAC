    --indicatorSize: ${v.ysJ};
    --size: 20px;
  }
  :host([size='extra-small']) {
    --indicatorSize: ${v.ysJ};
    --size: 24px;
  }
  :host([size='small']) {
    --indicatorSize: ${v.ysJ};
    --size: 28px;
  }
  :host([size='large']) {
