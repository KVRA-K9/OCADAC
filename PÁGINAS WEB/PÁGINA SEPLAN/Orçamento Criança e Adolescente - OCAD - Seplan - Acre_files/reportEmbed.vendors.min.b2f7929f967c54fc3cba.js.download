    padding-inline: ${f.lIx} ${f.Ulf};
    border-radius: ${f.EEO};
    font-family: ${f.b1T};
    font-size: ${f.Lhu};
    font-weight: ${f.ycS};
    line-height: ${f._$v};
    grid-template-columns: auto auto 1fr auto;
  }

  .button {
    appearance: none;
    background: ${f.sks};
    border: none;
    box-sizing: border-box;
    color: ${f.Few};
    cursor: pointer;
    font: inherit;
    grid-column: auto / span 2;
    grid-row: 1;
    height: 44px;
    outline: none;
    padding: 0;
    text-align: start;
  }

  .button::before {
    content: '';
    position: absolute;
    inset: 0px;
    cursor: pointer;
    border-radius: ${f.aUB};
  }

