    ];

    var ul = $(".lista-indicadores");
    var objetivo = ul.data('objetivo');
    nome_objetivo = $("#descricao-objetivo").text();
    $("#descricao-objetivo").html("<h2>" + nome_objetivo + " " + descricaoObjetivos[objetivo - 1] + "</h2>")
    var urlMetas = "/objetivo/MetadadosAPIMeta?n=" + objetivo;
    var urlRotas = "/objetivo/RotasValidas?n=" + objetivo;

    ul.loading('Carregando');




    jQuery.ajax({
        type: "GET",
        url: urlMetas
    }).fail(function () {
        alert('Erro ao fazer download dos dados');
    }).done(function (data) {
        ul.loading('close');
        //Ordena as metas recebidas
        data = JSON.parse(data);
        data = ordenarIndicadores(data);

        $divAccordion = $("<div>").attr("id", "accordion")
        $divAccordion.appendTo(ul)


        for (var i = 0; i < data.length; i++) {
            var d = data[i];

            //Nome da meta
            var nomeMeta = d.numero + " - " + d.nome;

            //Card
            $card = $("<div>").addClass("card").addClass("mb-3")

            //CardHeader
            $cardHeader = $("<div>").addClass("card-header background-metas")

            //Texto Meta
            $textoMeta = $("<p>").addClass("layout-header-metas").html(nomeMeta)
            $textoMeta.addClass("font-pequena m-1").appendTo($cardHeader)

            //Finalizando o Card
            $card.appendTo($divAccordion)
            $cardHeader.appendTo($card)


            //Listagem Indicadores
            if (d.indicadores != null && d.indicadores.length > 0) {
                //Corpo do Card, onde serão listados os indicadores    
                $cardBody = $("<div>")
                //Conteúdo do card
                $cardBodyConteudo = $("<div>").addClass("card-body")
                $cardBodyConteudo.appendTo($cardBody)
                //Atrelar conteúdo ao corpo
                $cardBody.appendTo($card)

                //Vamos adicionar os indicadores ao conteúdo, ou seja, ao $cardBodyConteudo
                var indicadores = ordenarIndicadores(d.indicadores);

                for (var j = 0; j < +indicadores.length; j++) {


                    var indicador = indicadores[j];
                    var $indicador = $("<li>").appendTo($cardBodyConteudo)

                    /*

                    if (indicador.possui_ficha === true && indicador.status == 'Produzido') {
                        $("<a>")
                            .attr('href', url)
                            .html(indicador.numero + " - " + indicador.nome)
                            .appendTo(liIndicador);
                    } else {
                        liIndicador.html(indicador.numero + " - " + indicador.nome);
                    }*/

                    //Definir o status do indicador aqui - aqui volta do metadados, podendo ser: verde, amarelo, cinza, vermelho, laranja
                    var statusIndicador = null;

                    //1 Produzido (verde)
                    //2	Em análise/construção (amarelo)
                    //3	Sem dados (laranja)
                    //4	Sem metodologia (vermelho)
                    //5	Não se aplica ao Brasil (cinza)

                    if (indicador.status == 'Produzido') {
                        statusIndicador = "verde";
                    } else if (indicador.status == 'Em análise/construção') {
                        statusIndicador = "amarelo";
                    } else if (indicador.status == 'Sem dados') {
                        statusIndicador = "sem-dados";
                    } else if (indicador.status == 'Sem metodologia') {
                        statusIndicador = "vermelho";
                    } else if (indicador.status == 'Não se aplica ao Brasil') {
                        statusIndicador = "cinza";
                    }

                    //Status do indicador aqui - concatenar a cor do indicador para obter a classe correta. 
                    //Verificar se a cor recebida é a mesma da classe : verde, amarelo, cinza, vermelho, laranja
                    $indicador.addClass("indicador-link");

                    if (statusIndicador) {
                        $indicador.addClass("indicador-texto indicador-link-" + statusIndicador).attr("indicador", indicador.numero).attr("status", indicador.status);
                    }

                    //Adiciona o conte
                    if (indicador.possui_ficha === true && indicador.status == 'Produzido') {
                        var nobj = indicador.numero.split(".")[0].replace(/[a-zA-Z]/gi, '');
                        var url = "/objetivo" + nobj + "/indicador" + indicador.numero.split(".").join("");

                        $("<a>")
                            .attr("href", url)
                            .html(indicador.numero + " - " + indicador.nome)
                            .appendTo($indicador);
                    } else {
                        $indicador.html(indicador.numero + " - " + indicador.nome);
                    }
                }

            }
        }
        jQuery.ajax({
            type: "GET",
            url: urlDadosPesquisa,
        }).fail(function () {
        }).done(function (data) {
            hsh = {}

            for (index = 0; index < data.length; index++) {
                var reg = new RegExp(/\d{1,2}\.[0-9a-z]{1,2}\.\d{1,2}/gm);
                var result;
                while (result = reg.exec(data[index].Nome)) {
                    hsh[result] = [data[index].DataAtualizacao, data[index].Recente]
                }
            }

          
        }

        )
    });


});

function mostrarCloneLegenda() {
    if ($("#legenda-cores-clone").length != 0)
        return;

    $("<div>")
        .attr("id", "legenda-cores-clone")
        .addClass("legenda-cores-fixed")
        .append($("<div>")
            .addClass("container")
            .append($("#legenda-cores").clone())
        ).appendTo("body")

    $("#legenda-cores").css("visibility", "hidden");
}

function esconderCloneLegenda() {
    var legClone = $("#legenda-cores-clone");

    if (legClone.length == 0)
        return;

    $("#legenda-cores").css("visibility", "visible");
    legClone.remove();
}


$(window).on('scroll', function () {
    var leg = $("#legenda-cores");

    setTimeout(function () {
        var pos = $(window).scrollTop();
        if (pos > leg.offset().top)
            mostrarCloneLegenda();
        else
            esconderCloneLegenda();
    }, 0);
});

function parteOrdenador(t) {
    return (t.length < 2 || t[t.length - 1] <= '9') ? ("000" + t).slice(-3) + "0" : ("0000" + t).slice(-4);
}

function gerarOrdenador(item) {
    var partes = item.numero.split(".");
    for (var i = partes.length; i--;)
        partes[i] = parteOrdenador(partes[i]);
    item.ordem = partes.join(".");
}

function ordenarIndicadores(lista) {
    for (var i = 0, l = lista.length; i < l; i++)
        gerarOrdenador(lista[i]);
    lista = lista.sort(function (a, b) { return a.ordem.localeCompare(b.ordem); });
    return lista;
}
