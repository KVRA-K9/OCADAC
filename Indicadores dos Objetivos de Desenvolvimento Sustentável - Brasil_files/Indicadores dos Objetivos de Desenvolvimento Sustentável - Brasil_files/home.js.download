                        var $a = $("<a>").attr("href", "/Objetivo" + objetivo + "/" + "Indicador" + indicador.join("")).html(dado["Nome"])
                        var $td1 = $("<td>").html(numeroIndicador)
                        var $td2 = $("<td>")
                        $a.appendTo($td2)
                        $td1.appendTo($tr)
                        $td2.appendTo($tr)
                        $tr.appendTo($element)
                        indicadores[numeroIndicador] = false
                    }



                }

                //$("#modal-busca").modal("show");
            });
        }

    });


    $(".busca").on("click", function () {
        var palavras = $(".busca-indicadores").val();

        $.ajax({
            type: "GET",
