            $(templateAux).appendTo($("#eventos"));

        }
        //$(templateMaisEventos).appendTo($("#eventos"));

    })


    $("#mais-eventos-link").on('click', function () {
        eventosNumero = 6;
        mostrarEventos(eventosNumero);
    });

    $(".lupa").on("click", function () {
        $("#modal-busca").modal("show");
    }
    );
    var input = document.getElementById("searchbox")
    input.addEventListener("keypress", function () {
        if (event.key === "Enter") {

        $("#modal-busca").modal("show");
            var palavras = $("#searchbox").val();
            $.ajax({
                type: "GET",
