Frect%3E%3Cg%3E%3Ctext%20x%3D%2211.546875%22%20y%3D%2216.9%22%3E32x32%3C%2Ftext%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E"]
colors = ["#007bff;", "#e83e8c;", "#6f42c1;"]


function parseDate(data) {
    dataList = data.split("-")
    year = dataList[0]
    month = dataList[1]
    day = dataList[2].slice(0, 2)
    return day + "/" + month + "/" + year
}

function presentTitle(dataInicio, dataFim, localizacao) {
    dataInicio = parseDate(dataInicio)
    dataFim = parseDate(dataFim)
    title = ""
    if (dataInicio == dataFim) {
        title = dataInicio
    } else {
        title = dataInicio + " a " + dataFim
    }
    title += " | " + localizacao
    return title
}
function mostrarEventos(numeroEventos) {
    eventosNumero = eventosNumero + 4;
    $.ajax({
        type: "POST",
        url: urlEventos + numeroEventos
    }).fail(function () {

    }).done(function (dados) {
        $("#modal-eventos").modal("show");
        $("#modal-eventos-body").html("");

        for (index = 0; index < dados.length; index++) {
            templateAux = fillTemplateEventos(dados[index], index)
            templateMaisEventos = "<div id ='maisEventos' onclick='mostrarEventos(" + eventosNumero + ");' class='mx-auto d-block link-mais text-center'>Mais Eventos</div>";
            $(templateAux).appendTo($("#modal-eventos-body"));
            $(templateMaisEventos).appendTo($("#modal-eventos-body"));
        }

    })
}

function fillTemplateEventos(dado, index) {
    templateAux = template
    title = presentTitle(dado.DataInicio, dado.DataFim, dado.Localizacao)
    templateAux = templateAux.replace("${title}", title);
    templateAux = templateAux.replace("${summary}", dado.Descricao);
    templateAux = templateAux.replace("${color}", colors[index % 3]);
    templateAux = templateAux.replace("${color}", colors[index % 3]);
    templateAux = templateAux.replace("${image-color}", image_colors[index % 3]);
    return templateAux
}
